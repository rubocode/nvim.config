-- Rust Analyzer Configuration
-- Initial attempt
-- 2026/09/19

vim.lsp.config("rust_analyzer", {
	cmd = { "rust-analyzer" },
	filetypes = { "rust" },
	root_markers = { "Cargo.toml", ".git" },
	settings = {
		["rust-analyzer"] = {
			cargo = {
				allFeatures = true, -- Enable all cargo features for robust completion
			},
			check = {
				command = "clippy", -- Use clippy instead of cargo check for linting
			},
			diagnostics = {
				enable = true,
			},
		},
	},
})

vim.lsp.enable("rust_analyzer")
